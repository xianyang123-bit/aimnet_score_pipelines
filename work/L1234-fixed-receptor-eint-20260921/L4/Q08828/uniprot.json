{"entryType":"UniProtKB reviewed (Swiss-Prot)","primaryAccession":"Q08828","secondaryAccessions":["A4D2L8","Q75MI1"],"uniProtkbId":"ADCY1_HUMAN","entryAudit":{"firstPublicDate":"1994-10-01","lastAnnotationUpdateDate":"2026-09-02","lastSequenceUpdateDate":"2005-04-12","entryVersion":212,"sequenceVersion":2},"annotationScore":5.0,"organism":{"scientificName":"Homo sapiens","commonName":"Human","taxonId":9606,"lineage":["Eukaryota","Metazoa","Chordata","Craniata","Vertebrata","Euteleostomi","Mammalia","Eutheria","Euarchontoglires","Primates","Haplorrhini","Catarrhini","Hominidae","Homo"]},"proteinExistence":"1: Evidence at protein level","proteinDescription":{"recommendedName":{"fullName":{"value":"Adenylate cyclase type 1"},"ecNumbers":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P19754"}],"value":"4.6.1.1"}]},"alternativeNames":[{"fullName":{"value":"ATP pyrophosphate-lyase 1"}},{"fullName":{"value":"Adenylate cyclase type I"}},{"fullName":{"value":"Adenylyl cyclase 1"}},{"fullName":{"value":"Ca(2+)/calmodulin-activated adenylyl cyclase"}}]},"genes":[{"geneName":{"value":"ADCY1"}}],"comments":[{"texts":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"O88444"},{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P19754"}],"value":"Catalyzes the formation of the signaling molecule cAMP in response to G protein signaling. Mediates responses to increased cellular Ca(2+)/calmodulin levels (By similarity). May be involved in regulatory processes in the central nervous system. May play a role in memory and learning. Plays a role in the regulation of the circadian rhythm of daytime contrast sensitivity probably by modulating the rhythmic synthesis of cyclic AMP in the retina (By similarity)"}],"commentType":"FUNCTION"},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"ATP = 3',5'-cyclic AMP + diphosphate","reactionCrossReferences":[{"database":"Rhea","id":"RHEA:15389"},{"database":"ChEBI","id":"CHEBI:30616"},{"database":"ChEBI","id":"CHEBI:33019"},{"database":"ChEBI","id":"CHEBI:58165"}],"ecNumber":"4.6.1.1","evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P19754"}]}},{"commentType":"COFACTOR","cofactors":[{"name":"Mg(2+)","evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P19754"}],"cofactorCrossReference":{"database":"ChEBI","id":"CHEBI:18420"}},{"name":"Mn(2+)","evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P19754"}],"cofactorCrossReference":{"database":"ChEBI","id":"CHEBI:29035"}}],"note":{"texts":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P30803"}],"value":"Binds 2 magnesium ions per subunit. Is also active with manganese (in vitro)."}]}},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P19754"}],"value":"Activated by G(s) G alpha protein GNAS. Inhibited by G(i) G alpha protein GNAI1. Is further activated by the complex formed by GNB1 and GNG2. Activated by calcium/calmodulin. Inhibited by the ATP analogs adenosine, 2'-deoxyadenosine and 2'-deoxy-3'-AMP"}],"commentType":"ACTIVITY REGULATION"},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P19754"}],"value":"Interacts with CALM"}],"commentType":"SUBUNIT"},{"commentType":"SUBCELLULAR LOCATION","note":{"texts":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"O88444"}],"value":"Expressed in the cytoplasm of supporting cells and hair cells of the cochlea vestibule, as well as to the cochlear hair cell nuclei and stereocilia"}]},"subcellularLocations":[{"location":{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P19754"}],"value":"Membrane","id":"SL-0162"},"topology":{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P19754"}],"value":"Multi-pass membrane protein","id":"SL-9909"}},{"location":{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"11549699"}],"value":"Cell membrane","id":"SL-0039"